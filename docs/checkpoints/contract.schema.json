{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sb-dev/pactwright/blob/main/docs/checkpoints/contract.schema.json",
  "title": "Checkpoint contract (format 2)",
  "description": "Minimal format schema for checkpoint contract files: checkpoint.yml (declares format) or one step contract per file. Owned by docs/specs/00-checkpoint-step-contract-and-delivery-tasks.md §§2–3. Cross-file rules (declared source keys, requirement coverage, step references) are checked by the harness, not this schema.",
  "if": { "type": "object", "required": ["format"] },
  "then": { "$ref": "#/$defs/checkpoint" },
  "else": { "$ref": "#/$defs/step" },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "checkpoint", "run_model", "sources"],
      "properties": {
        "format": { "const": 2 },
        "checkpoint": { "type": "string", "pattern": "^CP[0-9]{2}$" },
        "run_model": { "$ref": "#/$defs/name" },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/text" }
        },
        "requirements": { "$ref": "#/$defs/requirements" },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      },
      "dependentRequired": {
        "requirements": ["acceptance"],
        "acceptance": ["requirements"]
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requires", "outputs", "requirements", "acceptance"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stepId" }
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": {
            "anyOf": [{ "$ref": "#/$defs/sourceRef" }, { "$ref": "#/$defs/outputRef" }]
          }
        },
        "uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/text" }
        },
        "requirements": { "$ref": "#/$defs/requirements" },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      }
    },
    "requirements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^R[0-9]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/requirement" }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "statement"],
      "properties": {
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "statement": { "$ref": "#/$defs/text" }
      }
    },
    "acceptance": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^AC[0-9]{2}$" },
      "additionalProperties": { "$ref": "#/$defs/criterion" }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covers", "given", "when", "then", "verify"],
      "properties": {
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^R[0-9]{2}$" }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "given": { "$ref": "#/$defs/text" },
        "when": { "$ref": "#/$defs/text" },
        "then": { "$ref": "#/$defs/text" },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "automated": { "$ref": "#/$defs/bindings" },
            "review": { "$ref": "#/$defs/bindings" },
            "approval": { "$ref": "#/$defs/bindings" }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
      }
    },
    "stepId": { "type": "string", "pattern": "^CP[0-9]{2}-S[0-9]{2}$" },
    "outputRef": {
      "type": "string",
      "pattern": "^CP[0-9]{2}-S[0-9]{2}/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*#([0-9]+|[a-z0-9]+(-[a-z0-9]+)*)$"
    },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 }
  }
}
