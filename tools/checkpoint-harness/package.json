{
  "name": "@pactwright/checkpoint-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Bootstrap harness that loads checkpoint contracts and prepares executable work (Spec 00 T3).",
  "type": "module",
  "scripts": {
    "contracts:check": "node --import tsx src/checkpoint-contracts.ts",
    "harness": "node --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:integration": "node --test --import tsx test/integration/*.test.ts",
    "test:live": "node --test --import tsx test/live/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "ajv": "^8.20.0",
    "commander": "^14.0.3",
    "graphology": "^0.26.0",
    "graphology-traversal": "^0.3.1",
    "js-yaml": "^4.3.1",
    "safe-stable-stringify": "^2.5.0",
    "tar": "^7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "graphology-types": "^0.24.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
