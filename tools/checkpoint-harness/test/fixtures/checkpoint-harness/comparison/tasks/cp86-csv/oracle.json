{
  "module": "work/csv.mjs",
  "cases": [
    {
      "args": [
        "a,b,c"
      ],
      "stdout": "[\"a\",\"b\",\"c\"]\n"
    },
    {
      "args": [
        "\"a,b\",c"
      ],
      "stdout": "[\"a,b\",\"c\"]\n"
    },
    {
      "args": [
        "\"say \"\"hi\"\"\",x"
      ],
      "stdout": "[\"say \\\"hi\\\"\",\"x\"]\n"
    },
    {
      "args": [
        ""
      ],
      "stdout": "[\"\"]\n"
    },
    {
      "args": [
        "a,,b"
      ],
      "stdout": "[\"a\",\"\",\"b\"]\n"
    },
    {
      "args": [
        "\"\""
      ],
      "stdout": "[\"\"]\n"
    },
    {
      "args": [
        "x,\"y\""
      ],
      "stdout": "[\"x\",\"y\"]\n"
    }
  ]
}
