#!/usr/bin/env node
/**
 * Stand-in for the `claude` binary, for the A2-L probes.
 *
 * It replaces the external process and nothing else: every byte of prompt
 * construction, `--agents` assembly and print-mode parsing in
 * src/execute/claude-code.ts runs for real against it.
 *
 * It creates no Evidence, writes no execution state and repairs nothing.
 * In `obey` mode it runs the `pactwright lifecycle record` call that the
 * prompt the runtime handed it instructs an agent to run — that is a
 * compliant agent, not a repair.
 *
 * PROBE_MODE:
 *   report  return PROBE_RESULT as the print-mode `result` (default)
 *   obey    additionally make the runtime call the prompt instructs
 *   error   return an is_error response
 *   denied  return an is_error response carrying permission_denials
 * PROBE_FAIL_STAGE makes only that one stage behave as `error`.
 *
 * Deliberately extensionless: the repository lints and formats `.js`/`.cjs`
 * /`.mjs` everywhere, and this file is an executable fixture, not source.
 */
import { execFileSync } from "node:child_process";
import { appendFileSync, mkdtempSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const argv = process.argv.slice(2);
const at = (flag) => (argv.indexOf(flag) < 0 ? undefined : argv[argv.indexOf(flag) + 1]);
const prompt = at("-p") ?? "";
const root = at("--add-dir") ?? process.cwd();
const subject = (/^Subject: (\S+)/m.exec(prompt) ?? [])[1];
const stage = (/lifecycle record (\w+) --file/.exec(prompt) ?? [])[1];
const log = process.env.PROBE_SPAWN_LOG;

let mode = process.env.PROBE_MODE ?? "report";
if (process.env.PROBE_FAIL_STAGE && stage === process.env.PROBE_FAIL_STAGE) mode = "error";

const note = (text) => {
  if (log) appendFileSync(log, `${text}\n`);
};

note(`SPAWN stage=${stage ?? "-"} subject=${subject ?? "-"} mode=${mode}`);
note(`  prompt sections: ${(prompt.match(/^## .*$/gm) ?? ["<none>"]).join(" | ")}`);

if (mode === "obey" && stage && subject) {
  const file = join(mkdtempSync(join(tmpdir(), "a2l-agent-")), "in.yml");
  const outcome = process.env.PROBE_AGENT_OUTCOME ?? "pass";
  writeFileSync(
    file,
    stage === "review" ? `intent: ${subject}\noutcome: ${outcome}\n` : `intent: ${subject}\n`,
  );
  try {
    const out = execFileSync(
      process.execPath,
      [process.env.PROBE_CLI, "lifecycle", "record", stage, "--file", file],
      { cwd: root, encoding: "utf8" },
    );
    note(`  agent recorded -> ${out.trim()}`);
  } catch (error) {
    note(`  agent record FAILED -> ${String((error.stdout ?? "") + (error.stderr ?? "")).trim()}`);
  }
}

if (mode === "error") {
  process.stdout.write(
    JSON.stringify({
      result: "could not continue",
      is_error: true,
      subtype: "error_during_execution",
    }),
  );
} else if (mode === "denied") {
  process.stdout.write(
    JSON.stringify({
      result: "blocked by permissions",
      is_error: true,
      subtype: "error_during_execution",
      permission_denials: [{ tool_name: "Write", tool_input: { file_path: "/etc/hosts" } }],
    }),
  );
} else {
  process.stdout.write(
    JSON.stringify({
      result: process.env.PROBE_RESULT ?? "pass",
      is_error: false,
      subtype: "success",
      usage: { input_tokens: 10, output_tokens: 5 },
      total_cost_usd: 0.01,
    }),
  );
}
