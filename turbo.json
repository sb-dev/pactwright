{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "cache": false },
    "//#format:check": { "cache": false },
    "//#lint": { "cache": false },
    "//#typecheck:root": { "cache": false },
    "//#test:root": { "cache": false },
    "//#build:root": { "outputs": ["dist/**"] },
    "//#verify:build:root": { "outputs": ["dist/**"] }
  }
}
